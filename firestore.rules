rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return currentUserDoc().data;
    }

    function currentUserRole() {
      return currentUserExists() && ('role' in currentUserData())
        ? currentUserData().role
        : 'studio';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStudio() {
      return signedIn() && currentUserRole() == 'studio';
    }

    function isClient() {
      return signedIn() && currentUserRole() == 'client';
    }

    function studioOwnsIncomingRecord() {
      return isStudio() && request.resource.data.user_id == request.auth.uid;
    }

    function studioOwnsExistingRecord() {
      return isStudio() && resource.data.user_id == request.auth.uid;
    }

    function studioKeepsOwnership() {
      return request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;
    }

    function clientCanReadRecord() {
      return isClient()
        && resource.data.client_id == currentUserData().client_id
        && resource.data.user_id == currentUserData().studio_owner_id;
    }

    function clientCanReadOwnClient(clientId) {
      return isClient()
        && clientId == currentUserData().client_id
        && resource.data.user_id == currentUserData().studio_owner_id;
    }

    function clientCanCreateMessage() {
      return isClient()
        && request.resource.data.client_id == currentUserData().client_id
        && request.resource.data.user_id == currentUserData().studio_owner_id
        && request.resource.data.sender_role == 'client'
        && request.resource.data.outbound == false;
    }

    // A client may fill in their own questionnaire until it is submitted,
    // touching only their answers and its progress fields.
    function clientCanAnswer() {
      return clientCanReadRecord()
        && resource.data.status != 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'updated_at', 'submitted_at'])
        && request.resource.data.status in ['in_progress', 'submitted']
        && request.resource.data.answers is map;
    }

    // A client may comment on work shared with them (which updates its activity time),
    // and may approve it or ask for changes while it is waiting for their decision.
    function clientCanUpdateReview() {
      return clientCanReadRecord() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client_activity_at', 'updated_at'])
        || (resource.data.status == 'in_review'
          && request.resource.data.status in ['approved', 'changes_requested']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decided_at', 'decision_note', 'client_activity_at', 'updated_at']))
      );
    }

    function publicFormTargetExists() {
      return request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && exists(/databases/$(database)/documents/users/$(request.resource.data.user_id));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if isOwner(userId);
    }

    match /clients/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadOwnClient(docId);
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /projects/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /invoices/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /proposals/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /contracts/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /events/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /messages/{docId} {
      allow create: if studioOwnsIncomingRecord() || clientCanCreateMessage();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /questionnaires/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord();
      allow update: if studioOwnsExistingRecord() && studioKeepsOwnership();
      allow delete: if studioOwnsExistingRecord();
    }

    match /questionnaire_responses/{docId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if (studioOwnsExistingRecord() && studioKeepsOwnership()) || clientCanAnswer();
      allow delete: if studioOwnsExistingRecord();
    }

    match /reviews/{reviewId} {
      allow create: if studioOwnsIncomingRecord();
      allow get, list: if studioOwnsExistingRecord() || clientCanReadRecord();
      allow update: if (studioOwnsExistingRecord() && studioKeepsOwnership()) || clientCanUpdateReview();
      allow delete: if studioOwnsExistingRecord();

      match /comments/{commentId} {
        function parentReview() {
          return get(/databases/$(database)/documents/reviews/$(reviewId)).data;
        }
        function studioOwnsReview() {
          return isStudio() && parentReview().user_id == request.auth.uid;
        }
        function clientOwnsReview() {
          return isClient()
            && parentReview().client_id == currentUserData().client_id
            && parentReview().user_id == currentUserData().studio_owner_id;
        }
        function validComment(role) {
          return request.resource.data.author_role == role
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 5000
            && request.resource.data.keys().hasOnly(['author_role', 'author_name', 'text', 'created_at', 'decision']);
        }
        allow get, list: if studioOwnsReview() || clientOwnsReview();
        allow create: if (studioOwnsReview() && validComment('studio')) || (clientOwnsReview() && validComment('client'));
        allow update: if false;
        allow delete: if studioOwnsReview();
      }
    }

    match /form_configs/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isStudio() && request.auth.uid == userId && request.resource.data.user_id == request.auth.uid;
    }

    match /form_submissions/{docId} {
      allow create: if publicFormTargetExists()
        && request.resource.data.data is map
        && request.resource.data.submitted_at is string
        && request.resource.data.keys().hasOnly(['user_id', 'data', 'submitted_at']);
      allow get, list: if studioOwnsExistingRecord();
      allow update, delete: if false;
    }
  }
}
